# resilience_agent configuration (copy to .env or export). Never commit real secrets.
RA_PROVIDER=ollama
RA_MODEL=qwen2.5-coder:3b          # qwen2.5-coder:7b on machines with a GPU or more cores
OLLAMA_HOST=http://127.0.0.1:11434
RA_NUM_CTX=8192
RA_SEED=7
RA_LLM_TIMEOUT=420
RA_PYTHONS=3.12,3.13
RA_INSTALL_MODES=requirements,package
RA_MAX_ATTEMPTS=3
RA_REVISION_ROUNDS=1
RA_COUNCIL_LIMIT=4
RA_COMMAND_TIMEOUT=600
RA_OFFLINE=0
RA_DEEPWIKI_REPO=rishrek/LinkWatch
# Set to 1 only when you want `publish` to actually push the branch and open a draft PR.
RA_ALLOW_PUBLISH=0
RA_NUM_PREDICT=1500
